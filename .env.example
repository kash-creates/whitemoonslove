# Copy this file to .env.local and fill in real values.
# Without these, the site still runs but falls back to a local JSON
# file for storage (fine for testing, NOT safe for a live client site
# on Vercel/Netlify — that storage does not persist between requests).

# --- Supabase (database) ---
# Get these from your Supabase project: Settings -> API
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the anon/public key — this one must
# never be exposed to the browser, which is why it has no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email notifications on new booking/contact) ---
# Sign up free at resend.com, verify a sending domain (or use their
# test domain while developing), then create an API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
OWNER_NOTIFICATION_EMAIL=ashrafshekhalvi@gmail.com

# --- Admin access ---
# Any long random string. Required to view /api/bookings and
# /api/contact via GET (send it as header: x-admin-key: <this value>).
ADMIN_API_KEY=
